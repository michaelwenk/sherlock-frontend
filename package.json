{
  "name": "sherlock-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cp index.dev.html index.html && vite --strictPort --mode development",
    "start": "cp index.prod.html index.html && vite --strictPort --mode production",
    "build": "rm -rf -- dist && cp index.prod.html index.html && tsc && vite build",
    "compile": "tsc",
    "clean-install": "rm -f -- package-lock.json && rm -rf -- node_modules && npm install",
    "eslint": "eslint .",
    "eslint-fix": "npm run eslint --fix",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@fortawesome/react-fontawesome": "3.3.0",
    "@types/react-cytoscapejs": "1.2.6",
    "@zakodium/nmrium-core": "0.7.13",
    "@zakodium/nmrium-core-plugins": "0.7.16",
    "axios": "1.15.0",
    "cytoscape-cose-bilkent": "4.1.0",
    "file-collection": "6.6.1",
    "file-saver": "2.0.5",
    "formik": "2.4.9",
    "immer": "11.1.4",
    "lodash": "4.18.1",
    "nmr-correlation": "3.0.1",
    "nmrium": "2.0.0",
    "openchemlib": "9.22.0",
    "react-cytoscapejs": "2.0.0",
    "react-dropzone": "15.0.0",
    "react-intersection-observer": "10.0.3",
    "react-loader-spinner": "8.0.2",
    "react-mf": "3.1.1",
    "react-modal": "3.16.3",
    "react-ocl": "8.7.0",
    "react-split-pane": "3.2.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.28.6",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@blueprintjs/core": "6.12.0",
    "@blueprintjs/icons": "6.9.0",
    "@blueprintjs/select": "6.1.9",
    "@eslint/js": "9.39.4",
    "@types/node": "25.6.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/react-modal": "3.16.3",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.5.0",
    "prettier": "3.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "vite": "8.0.8"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.0.0",
    "@blueprintjs/icons": "^6.0.0",
    "@blueprintjs/select": "^6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
