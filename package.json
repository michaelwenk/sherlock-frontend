{
  "name": "sherlock-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host localhost --port 3001 --strictPort",
    "build": "rm -rf -- dist && tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "compile": "tsc",
    "clean-install": "rm -f -- package-lock.json && rm -rf -- node_modules && npm install --legacy-peer-deps",
    "eslint": "eslint .",
    "eslint-fix": "npm run eslint --fix",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@types/react-cytoscapejs": "^1.2.6",
    "axios": "^1.13.6",
    "cytoscape-cose-bilkent": "^4.1.0",
    "file-saver": "^2.0.5",
    "formik": "^2.4.9",
    "immer": "^11.1.4",
    "lodash": "^4.17.23",
    "nmr-correlation": "^3.0.1",
    "nmrium": "^2.0.0",
    "openchemlib": "^9.21.0",
    "react-cytoscapejs": "^2.0.0",
    "react-dropzone": "^15.0.0",
    "react-intersection-observer": "^10.0.3",
    "react-loader-spinner": "^8.0.2",
    "react-mf": "^3.1.1",
    "react-modal": "^3.16.3",
    "react-ocl": "^8.6.0",
    "react-split-pane": "^3.2.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@blueprintjs/core": "^6.10.0",
    "@blueprintjs/select": "^6.1.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^6.0.1",
    "bootstrap": "^5.3.8",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.0.0",
    "@blueprintjs/icons": "^6.0.0",
    "@blueprintjs/select": "^6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
